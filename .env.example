# ---------------------------------------------------------------------------
# Photo analysis
# Leave AI_PROVIDER unset (or anything other than "openai") to run in demo mode,
# where the scanner always returns the same sample result.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=sk-your-openai-api-key

# ---------------------------------------------------------------------------
# Postgres database (Neon, Railway, etc.)
# When set, the app uses Postgres instead of the JSON file.
# Required for Vercel / Netlify because they don't have a persistent disk.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Where the JSON database lives. Defaults to ./data
# In production point this at a MOUNTED PERSISTENT DISK, otherwise every
# deploy or restart wipes all accounts and meals.
#   Railway / Render / Fly.io volume example:
# ---------------------------------------------------------------------------
# DATA_DIR=/data
